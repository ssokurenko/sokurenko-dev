---
// Section list, generated from the taxonomy + live sheet counts.
// Sections with zero sheets are hidden per specs/04-front-page.md#4-section-grid —
// nine empty rows would advertise emptiness rather than hide it.
//
// There is no section index page (`<section>/index.mdx`) — see
// specs/01-information-architecture.md#no-section-index-pages. Instead
// each row lists every sheet in the section as its own badge link, so
// every real page is reachable straight from the homepage with no
// intermediate landing page to keep in sync as sheets are added.
//
// Rows stack full-width rather than sitting in a multi-column card grid:
// with a variable, growing number of sheets per section, side-by-side
// cards need matching row heights to look aligned, and that breaks the
// moment one section's badge count wraps to an extra line. A stacked
// list has no shared row to fall out of sync — each section is its own
// block, so it can never look "off" relative to its neighbor.
import { getCollection } from 'astro:content';
import { SECTIONS } from '../../config/taxonomy';

const entries = await getCollection('docs');

const sections = SECTIONS.map((section) => {
	const sheets = entries
		.filter((e) => e.id.startsWith(`${section.slug}/`))
		.map((e) => ({ id: e.id, title: e.data.title }))
		.sort((a, b) => a.title.localeCompare(b.title));
	return { ...section, sheets };
}).filter((section) => section.sheets.length > 0);
---

{
	sections.length > 0 && (
		<section aria-labelledby="browse-heading" class="section-list-wrap">
			<h2 id="browse-heading">Browse by section</h2>
			<ul class="section-list">
				{sections.map((section) => (
					<li class="section-row">
						<div class="section-row-head">
							<span class="section-row-label">{section.label}</span>
							<span class="section-row-count">
								{section.sheets.length} sheet{section.sheets.length === 1 ? '' : 's'}
							</span>
						</div>
						<p class="section-row-blurb">{section.blurb}</p>
						<div class="section-row-badges">
							{section.sheets.map((sheet) => (
								<a href={`/${sheet.id}/`} class="sheet-badge">
									{sheet.title}
								</a>
							))}
						</div>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.section-list-wrap {
		max-width: var(--sl-content-width);
		margin-inline: auto;
		padding-inline: 1.5rem;
		margin-block-start: 3rem;
	}

	#browse-heading {
		font-size: 1.1rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-gray-2);
		margin-block-end: 1.25rem;
	}

	.section-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.section-row {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		padding: 1.75rem 2rem;
		border-radius: 14px;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-bg-nav);
	}

	.section-row-head {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 1rem;
	}

	.section-row-label {
		font-weight: 700;
		font-size: clamp(1.5rem, 2vw + 1rem, 1.9rem);
		color: var(--sl-color-white);
	}

	.section-row-count {
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
		white-space: nowrap;
	}

	.section-row-blurb {
		font-size: 1rem;
		color: var(--sl-color-gray-2);
		line-height: 1.55;
		max-width: 60ch;
		margin: 0;
	}

	.section-row-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-block-start: 0.15rem;
	}

	.sheet-badge {
		display: inline-block;
		padding: 0.6rem 1.25rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-gray-5);
		background: var(--sl-color-bg);
		color: var(--sl-color-gray-1);
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color 150ms ease-out,
			color 150ms ease-out,
			background 150ms ease-out;
	}

	.sheet-badge:hover,
	.sheet-badge:focus-visible {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent);
	}

	@media (max-width: 30rem) {
		.section-row {
			padding: 1.5rem;
		}
	}
</style>
