---
import HeroSearch from './HeroSearch.astro';
import PopularChips from './PopularChips.astro';
---

<div class="home-hero">
	<h1 class="home-headline">Cheat sheets for the entire web stack</h1>
	<p class="home-tagline">
		Quick, accurate answers for the languages, frameworks, and tools
		you use every day — each sheet verified against primary sources,
		and typeset for reading on your Kindle.
	</p>
	<HeroSearch />
	<PopularChips />
</div>

<style>
	.home-hero {
		max-width: 40rem;
		margin-inline: auto;
		padding-inline: 1.5rem;
		padding-block-start: 3rem;
		text-align: center;
	}

	.home-headline {
		font-size: clamp(2.5rem, 6vw, 4rem);
		margin-block-end: 0.75rem;
	}

	.home-tagline {
		color: var(--sl-color-gray-2);
		max-width: 54ch;
		margin-inline: auto;
		margin-block-end: 2rem;
	}
</style>
