---
// One PDF download button. Extracted from PdfDownloadBar so that the bar
// decides *what* to offer (manifest lookup, dev/prod failure modes) and this
// decides *how* a single offer looks.
//
// The contract from specs/06-cheatsheet-page-template.md#requirements lives
// here now and must be preserved: `download` so it saves instead of opening
// in the browser's PDF viewer, `type="application/pdf"`, a human-meaningful
// filename, and an aria-label that states the file size — "downloads a
// 412 KB file" is information a screen-reader user needs before activating.
interface Props {
  href: string;
  /** Saved filename, e.g. `typescript-cheatsheet-kindle-small.pdf`. */
  filename: string;
  /** Size class, e.g. `Kindle small`. */
  label: string;
  /** Named target device, e.g. `Paperwhite 6.8″`, so the choice needs no explanation. */
  device: string;
  pages: number;
  bytes: number;
}
const { href, filename, label, device, pages, bytes } = Astro.props;

// KB is the right granularity: every sheet lands between ~100 KB and ~1 MB,
// and exact bytes are noise.
const size = `${Math.round(bytes / 1024)} KB`;

// aria-label overrides the inner text wholesale, so the "Free" pill is not
// announced twice — it has to be spelled out here instead.
const ariaLabel = `Download the free ${label} PDF for ${device}, ${pages} pages, ${size}`;
---

<a
	class="pdf-download"
	href={href}
	download={filename}
	type="application/pdf"
	aria-label={ariaLabel}
>
	<span class="pdf-download-icon" aria-hidden="true">
		{/* A PDF file mark — page with a folded corner, plus a PDF badge —
		    rather than a generic download arrow: what is on offer is the
		    file type, and the "Free download" lede above already says the
		    link downloads. Drawn here, not Adobe's trademarked logo, and
		    inline rather than an <img>/sprite so it inherits currentColor
		    on hover and costs no request (spec 09 allows no third-party
		    assets). `textLength` pins the badge word's width so a wider
		    system font can't push it past the badge. */}
		<svg viewBox="0 0 24 24" width="34" height="34" fill="none" focusable="false">
			<path
				d="M14.5 2.75H7A2.25 2.25 0 0 0 4.75 5v14A2.25 2.25 0 0 0 7 21.25h10A2.25 2.25 0 0 0 19.25 19V7.5z"
				stroke="currentColor"
				stroke-width="1.7"
				stroke-linejoin="round"
			/>
			<path d="M14.5 2.75V7.5h4.75" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
			<rect x="2.25" y="12.4" width="13.5" height="7.1" rx="1.8" fill="currentColor" />
			<text
				x="9"
				y="17.85"
				text-anchor="middle"
				textLength="9.6"
				lengthAdjust="spacingAndGlyphs"
				font-size="5.4"
				font-weight="700"
				letter-spacing="0.15"
				fill="var(--icon-knockout)"
			>
				PDF
			</text>
		</svg>
	</span>
	<span class="pdf-download-text">
		<span class="pdf-download-head">
			<span class="pdf-download-label">{label}</span>
			<span class="pdf-download-free">Free</span>
		</span>
		<span class="pdf-download-meta">{device} · {pages} pages · {size}</span>
	</span>
</a>

<style>
	.pdf-download {
		/* Science Blue (--sl-color-accent) is the same #0a66c2 in both themes,
		   so the text that sits on top of it is a literal white in both —
		   Starlight's --sl-color-white flips to near-black in light mode and
		   would drop the pill to 3.6:1. */
		--on-accent: #fff;

		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.6rem 0.75rem;
		border-radius: 10px;
		/* Outlined, not filled: the bar must not out-shout the "At a glance"
		   table for first attention (spec 06). The pop comes from the pill. */
		border: 1px solid var(--sl-color-accent);
		background: var(--sl-color-bg);
		color: var(--sl-color-white);
		text-decoration: none;
		line-height: 1.25;
		transition:
			background-color 120ms ease,
			border-color 120ms ease,
			transform 120ms ease,
			box-shadow 120ms ease;
	}

	.pdf-download:hover,
	.pdf-download:focus-visible {
		background: var(--sl-color-accent-low);
		transform: translateY(-1px);
		box-shadow: 0 4px 14px -6px var(--sl-color-accent);
	}

	.pdf-download:active {
		transform: translateY(0);
		box-shadow: none;
	}

	.pdf-download-icon {
		/* The badge word is knocked out of the filled badge, so it has to be
		   painted in whatever sits behind it — with no tile, that is the
		   button's own surface, which fills with accent-low on hover.
		   Painting it rather than leaving it transparent is what keeps the
		   letters legible over the page outline behind them. */
		--icon-knockout: var(--sl-color-bg);

		display: grid;
		place-items: center;
		flex-shrink: 0;
		color: var(--sl-color-accent-high);
		/* The badge word is small by necessity at this size; system-ui keeps
		   it crisp and costs no font request. */
		font-family: var(--site-font-system, system-ui);
	}

	.pdf-download:hover .pdf-download-icon,
	.pdf-download:focus-visible .pdf-download-icon {
		--icon-knockout: var(--sl-color-accent-low);
	}

	/* Both fills resolve to the system canvas here, so the knockout follows
	   it or the word disappears into the badge. */
	@media (forced-colors: active) {
		.pdf-download-icon,
		.pdf-download:hover .pdf-download-icon,
		.pdf-download:focus-visible .pdf-download-icon {
			--icon-knockout: Canvas;
		}
	}

	/* Motion is decoration here; the color and pill changes carry the state. */
	@media (prefers-reduced-motion: reduce) {
		.pdf-download {
			transition: none;
		}
		.pdf-download:hover,
		.pdf-download:focus-visible {
			transform: none;
		}
	}

	.pdf-download-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-inline-size: 0;
		flex: 1;
	}

	/* Pill sits beside the label rather than at the far edge of the button, so
	   the meta line gets the button's full width and "Paperwhite 6.8″ · 12
	   pages · 155 KB" stays on one line in a two-column bar. */
	.pdf-download-head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.pdf-download-label {
		font-size: 0.875rem;
		font-weight: 600;
	}

	.pdf-download-meta {
		font-size: 0.75rem;
		/* gray-2, not gray-3: gray-3 drops under 4.5:1 against the accent-low
		   hover fill in dark mode. */
		color: var(--sl-color-gray-2);
		font-variant-numeric: tabular-nums;
	}

	.pdf-download-free {
		flex-shrink: 0;
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.1rem 0.4rem;
		border-radius: 999px;
		background: var(--sl-color-accent);
		color: var(--on-accent);
	}

	@media print {
		.pdf-download {
			display: none;
		}
	}
</style>
