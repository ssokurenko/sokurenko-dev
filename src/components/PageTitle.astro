---
// Adds the topicVersion badge, staleness warning, and PDF download bar
// below the title, per specs/06-cheatsheet-page-template.md.
//
// Not rendered on the home page at all — index.mdx has `hero:` frontmatter,
// which routes Starlight's Page.astro into a branch that never calls
// PageTitle in the first place (see src/components/Hero.astro).
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PdfDownloadBar from './PdfDownloadBar.astro';
import {
  isStale,
  hasTopicVersion,
  formatTopicVersion,
  formatVerificationAge,
} from '../config/cheatsheet-schema';

const data = Astro.locals.starlightRoute.entry.data as any;
const cs = data.cheatsheet as
  | {
      slug: string;
      topicVersion: string;
      lastVerified: Date;
      pdf?: boolean;
    }
  | undefined;

const verified = cs ? new Date(cs.lastVerified) : undefined;
const stale = verified ? isStale(verified) : false;
const staleDays = verified ? Math.round((Date.now() - verified.getTime()) / 86_400_000) : 0;

// Versionless subjects (REST, API concepts) render no badge at all rather
// than a "vN/A" pill — see hasTopicVersion.
const version = cs && hasTopicVersion(cs.topicVersion) ? formatTopicVersion(cs.topicVersion) : null;
---

<Default><slot /></Default>

{
	cs && (
		<>
			{version && (
				<p class="sheet-meta">
					<span class="topic-version-badge" title={`Documents ${version}`}>
						{version}
					</span>
				</p>
			)}
			{stale && verified && (
				<aside class="staleness-notice" aria-label="Verification age">
					<span class="staleness-icon" aria-hidden="true">
						⚠
					</span>
					<span>
						Last verified{' '}
						<time datetime={verified.toISOString().slice(0, 10)}>
							{formatVerificationAge(staleDays)} ago
						</time>{' '}
						—
						may not reflect current behavior.
					</span>
				</aside>
			)}
			{cs.pdf !== false && <PdfDownloadBar slug={cs.slug} />}
		</>
	)
}

<style>
	/* Wraps the badge so the pull-up against the h1 belongs to the row, not
	   to the badge itself — a versionless sheet then renders nothing here
	   and leaves no gap behind. */
	.sheet-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin-block: -0.5rem 0.75rem;
	}

	.topic-version-badge {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 600;
		line-height: 1.5;
		font-variant-numeric: tabular-nums;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		background: var(--sl-color-accent-low);
		/* The ring keeps the pill legible where the tinted fill doesn't
		   survive: forced-colors mode, and grayscale printing. */
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, transparent);
		color: var(--sl-color-accent);
		margin-top: 1rem;
	}

	.staleness-notice {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		font-size: 0.9rem;
		line-height: 1.5;
		padding: 0.6rem 0.9rem;
		border-radius: 8px;
		border: 1px solid var(--sl-color-orange);
		background: var(--sl-color-orange-low);
		color: var(--sl-color-orange-high);
		margin-block-end: 1rem;
	}

	/* The glyph carries the warning where color can't — grayscale print and
	   e-ink screenshots of this page both lose the orange. */
	.staleness-icon {
		flex: none;
	}

	.staleness-notice time {
		font-variant-numeric: tabular-nums;
	}

	@media print {
		.sheet-meta {
			display: none;
		}
	}
</style>
