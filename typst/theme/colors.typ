// Shared grayscale ramp for PDF output. Meaning is carried by weight and
// slant, never hue alone — see specs/03-pdf-generation.md#code-highlighting-for-grayscale.
#let ink = rgb("#1a1a1a")
#let ink-mid = rgb("#4a4a4a")
#let ink-soft = rgb("#555555")
#let ink-faint = rgb("#8a8a8a")
#let hairline = rgb("#cccccc")
#let panel = rgb("#f7f7f7")
#let paper = rgb("#ffffff")
